# Copie este arquivo para .env e troque SEU_IP pelo IP da máquina que roda as APIs
# (ipconfig no Windows). O .env fica fora do Git: cada integrante tem o seu.
# Depois de alterar, reinicie o Expo: npx expo start --clear
EXPO_PUBLIC_API_URL=http://SEU_IP:3000
EXPO_PUBLIC_AUTH_URL=http://SEU_IP:3001
